<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Icons: 16-unit stroke paths, Fluent-like, drawn with the text colour. -->
  <Geometry x:Key="IconApp">M3,1.5 L13,1.5 A1.5,1.5 0 0 1 14.5,3 L14.5,13 A1.5,1.5 0 0 1 13,14.5 L3,14.5 A1.5,1.5 0 0 1 1.5,13 L1.5,3 A1.5,1.5 0 0 1 3,1.5 Z M8,1.5 L8,14.5 M1.5,8 L14.5,8</Geometry>
  <Geometry x:Key="IconTabs">M1,3.5 L5,3.5 L5,1.5 L11,1.5 L11,10.5 L1,10.5 Z</Geometry>
  <Geometry x:Key="IconColumns">M1,1 L4,1 L4,11 L1,11 Z M5,1 L7,1 L7,11 L5,11 Z M8,1 L11,1 L11,11 L8,11 Z</Geometry>
  <Geometry x:Key="IconRows">M1,1 L11,1 L11,4 L1,4 Z M1,5 L11,5 L11,7 L1,7 Z M1,8 L11,8 L11,11 L1,11 Z</Geometry>
  <Geometry x:Key="IconGrid">M1,1 L5.5,1 L5.5,5.5 L1,5.5 Z M6.5,1 L11,1 L11,5.5 L6.5,5.5 Z M1,6.5 L5.5,6.5 L5.5,11 L1,11 Z M6.5,6.5 L11,6.5 L11,11 L6.5,11 Z</Geometry>
  <Geometry x:Key="IconFocus">M1,1 L8,1 L8,11 L1,11 Z M9,1 L11,1 L11,4 L9,4 Z M9,4.5 L11,4.5 L11,7.5 L9,7.5 Z M9,8 L11,8 L11,11 L9,11 Z</Geometry>
  <Geometry x:Key="IconEye">M1.5,8 C1.5,8 4,3.5 8,3.5 C12,3.5 14.5,8 14.5,8 C14.5,8 12,12.5 8,12.5 C4,12.5 1.5,8 1.5,8 Z M8,6 A2,2 0 1 0 8,10 A2,2 0 1 0 8,6 Z</Geometry>
  <Geometry x:Key="IconSearch">M7,2.5 A4.5,4.5 0 1 0 7,11.5 A4.5,4.5 0 1 0 7,2.5 Z M10.5,10.5 L14,14</Geometry>
  <Geometry x:Key="IconGear">M8,5.8 A2.2,2.2 0 1 0 8,10.2 A2.2,2.2 0 1 0 8,5.8 Z M8,1.5 L8,3.5 M8,12.5 L8,14.5 M1.5,8 L3.5,8 M12.5,8 L14.5,8 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M3.4,12.6 L4.8,11.2 M11.2,4.8 L12.6,3.4</Geometry>
  <Geometry x:Key="IconRestart">M13,8 A5,5 0 1 1 11.5,4.4 M13,2.5 L13,5.5 L10,5.5</Geometry>
  <Geometry x:Key="IconKill">M4.5,3 L11.5,3 A1.5,1.5 0 0 1 13,4.5 L13,11.5 A1.5,1.5 0 0 1 11.5,13 L4.5,13 A1.5,1.5 0 0 1 3,11.5 L3,4.5 A1.5,1.5 0 0 1 4.5,3 Z</Geometry>
  <Geometry x:Key="IconPopOut">M7,3 L3,3 L3,13 L13,13 L13,9 M9,3 L13,3 L13,7 M13,3 L7.5,8.5</Geometry>
  <Geometry x:Key="IconDock">M9,13 L13,13 L13,3 L3,3 L3,7 M7,13 L3,13 L3,9 M3,13 L8.5,7.5</Geometry>
  <Geometry x:Key="IconMore">M3.5,6.7 A1.3,1.3 0 1 0 3.5,9.3 A1.3,1.3 0 1 0 3.5,6.7 Z M8,6.7 A1.3,1.3 0 1 0 8,9.3 A1.3,1.3 0 1 0 8,6.7 Z M12.5,6.7 A1.3,1.3 0 1 0 12.5,9.3 A1.3,1.3 0 1 0 12.5,6.7 Z</Geometry>
  <Geometry x:Key="IconPlus">M8,3 L8,13 M3,8 L13,8</Geometry>
  <Geometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</Geometry>
  <Geometry x:Key="IconMin">M3,8 L13,8</Geometry>
  <Geometry x:Key="IconMax">M3.5,3.5 L12.5,3.5 L12.5,12.5 L3.5,12.5 Z</Geometry>
  <Geometry x:Key="IconChevron">M4,6.5 L8,10.5 L12,6.5</Geometry>
  <!-- State glyphs, 10-unit. -->
  <Geometry x:Key="GlyphRunning">M5,1 A4,4 0 1 0 5,9 A4,4 0 1 0 5,1 Z</Geometry>
  <Geometry x:Key="GlyphRing">M5,1.2 A3.8,3.8 0 1 0 5,8.8 A3.8,3.8 0 1 0 5,1.2 Z</Geometry>
  <Geometry x:Key="GlyphDot">M5,3 A2,2 0 1 0 5,7 A2,2 0 1 0 5,3 Z</Geometry>
  <Geometry x:Key="GlyphCrashed">M5,1 L9.5,9 L0.5,9 Z</Geometry>
  <Geometry x:Key="GlyphKilled">M2.5,1.5 L7.5,1.5 A1,1 0 0 1 8.5,2.5 L8.5,7.5 A1,1 0 0 1 7.5,8.5 L2.5,8.5 A1,1 0 0 1 1.5,7.5 L1.5,2.5 A1,1 0 0 1 2.5,1.5 Z</Geometry>
  <Geometry x:Key="GlyphClockHand">M5,2.6 L5,5 L6.7,6.4</Geometry>
  <Geometry x:Key="GlyphSlash">M2.3,7.7 L7.7,2.3</Geometry>

  <Style x:Key="IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Text2}"/>
    <Setter Property="StrokeThickness" Value="1.4"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- Icon button: 32×32, 4 px radius, hover and press tints. -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Press}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-1" Stroke="{DynamicResource Text}" StrokeThickness="2" RadiusX="4" RadiusY="4"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window control buttons: the Windows 11 caption glyphs from Segoe Fluent Icons (MDL2 on Windows 10), 46 wide, full title bar height. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.ClearTypeHint="Enabled"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Press}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
              <Setter TargetName="Tx" Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#B0261A"/>
              <Setter TargetName="Tx" Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Mode switch segment: 26 px pill, selected segment raised on the surface colour. -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="13" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="Ic" Style="{StaticResource IconPath}" Data="{TemplateBinding Tag}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Text2}" Stroke="{x:Null}" Margin="0,0,6,0"/>
              <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
              <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Text}"/>
              <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="Ic" Property="Fill" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Bd" Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.18"/></Setter.Value>
              </Setter>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsChecked" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Press}"/>
              <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Text}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Title bar text button (Shown 4 of 4). -->
  <Style x:Key="TextButton" TargetType="Button">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Press}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Standard and primary buttons, 32 px, 4 px radius. -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Tab in the title bar: 28 px pill, active tab on the surface colour with a 1 px stroke. -->
  <Style x:Key="TabButton" TargetType="RadioButton">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="6,0,12,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Stroke2}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsChecked" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus and tooltips on the surface colour with an 8 px radius. -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="8">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2"/></Border.Effect>
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" CornerRadius="4" Padding="10,0" Background="Transparent" MinWidth="220">
            <DockPanel VerticalAlignment="Center">
              <TextBlock DockPanel.Dock="Left" x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Width="18" VerticalAlignment="Center" Visibility="Hidden"/>
              <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Text3}" FontSize="12" Margin="24,0,0,0"/>
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text3}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Fill="{DynamicResource Stroke}" Margin="8,4"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke2}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke2}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,2"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
</ResourceDictionary>
