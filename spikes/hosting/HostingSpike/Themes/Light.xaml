<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens v2, light. Cool off-white ground, white cards, one indigo accent. -->
  <SolidColorBrush x:Key="Mica" Color="#F3F4F8"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Surface2" Color="#F6F7FA"/>
  <SolidColorBrush x:Key="Text" Color="#15171C"/>
  <SolidColorBrush x:Key="Text2" Color="#555C6B"/>
  <SolidColorBrush x:Key="Text3" Color="#666D7C"/>
  <SolidColorBrush x:Key="Stroke" Color="#14141A2E"/>
  <SolidColorBrush x:Key="Stroke2" Color="#29141A2E"/>
  <SolidColorBrush x:Key="Hover" Color="#0D141A2E"/>
  <SolidColorBrush x:Key="Press" Color="#17141A2E"/>
  <SolidColorBrush x:Key="Accent" Color="#4A56D2"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#1A4A56D2"/>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#4A56D2" Offset="0"/>
    <GradientStop Color="#7B5BE8" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Ok" Color="#1A7F45"/>
  <SolidColorBrush x:Key="Warn" Color="#945C00"/>
  <SolidColorBrush x:Key="WarnBg" Color="#FFF4D6"/>
  <SolidColorBrush x:Key="Err" Color="#C2332A"/>
  <SolidColorBrush x:Key="Busy" Color="#4A56D2"/>
  <SolidColorBrush x:Key="BadgeText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="P1" Color="#2460C4"/>
  <SolidColorBrush x:Key="P2" Color="#B8472F"/>
  <SolidColorBrush x:Key="P3" Color="#8A3E85"/>
  <SolidColorBrush x:Key="P4" Color="#0F7A7A"/>
  <SolidColorBrush x:Key="P5" Color="#5B7A12"/>
  <SolidColorBrush x:Key="P6" Color="#8A5A00"/>
  <SolidColorBrush x:Key="P7" Color="#5146C8"/>
  <SolidColorBrush x:Key="P8" Color="#B4325F"/>
  <SolidColorBrush x:Key="P9" Color="#4E5E6E"/>
  <SolidColorBrush x:Key="P10" Color="#7A4E2E"/>
  <Color x:Key="ShadowColor">#141A2E</Color>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CardShadowOpacity">0.10</sys:Double>
</ResourceDictionary>
